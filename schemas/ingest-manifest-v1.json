{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seegerweiss.lovable.app/schemas/ingest-manifest-v1.json",
  "title": "Corpus ingest manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "idempotency_key", "matter", "dockets", "batch", "files", "totals"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 200 },
    "matter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "short_name", "caption", "docket_number", "court"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "short_name": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "docket_number": { "type": "string", "minLength": 1 },
        "court": { "type": "string", "minLength": 1 },
        "mdl_number": { "type": ["string", "null"] },
        "judge": { "type": ["string", "null"] },
        "magistrate_judge": { "type": ["string", "null"] },
        "cause": { "type": ["string", "null"] },
        "nature_of_suit": { "type": ["string", "null"] },
        "jury_demand": { "type": ["string", "null"] },
        "jurisdiction_type": { "type": ["string", "null"] },
        "date_filed": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "courtlistener_docket_id": { "type": ["integer", "null"] },
        "pacer_case_id": { "type": ["integer", "null"] },
        "courtlistener_url": { "type": ["string", "null"], "pattern": "^https://" },
        "pacer_url": { "type": ["string", "null"], "pattern": "^https://" },
        "stage": { "type": ["string", "null"] }
      }
    },
    "dockets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "docket_number"],
        "properties": {
          "source": { "enum": ["main", "jpml", "state", "appellate"] },
          "docket_number": { "type": "string", "minLength": 1 },
          "courtlistener_docket_id": { "type": ["integer", "null"] }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["full", "incremental"] },
        "filename_inference": { "type": "boolean", "default": false },
        "submitted_by": { "type": "string" },
        "callback_url": { "type": "string", "pattern": "^https://" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_name", "size_bytes"],
        "properties": {
          "file_name": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_slots", "pdf_files", "total_pages", "total_bytes"],
      "properties": {
        "document_slots": { "type": "integer", "minimum": 0 },
        "pdf_files": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
