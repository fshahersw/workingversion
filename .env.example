# Local development only. Copy to .env (gitignored); `bun run dev` loads it
# automatically. In AWS the same keys live in the CorpusServiceSecretArn secret
# (infra/app/app-runtime.cfn.yaml), never in a stack parameter.

# Research agent web search (optional; the AgentCore gateway is the anchor).
BRAVE_API_KEY=
TAVILY_API_KEY=
# Research landing headlines ("Since you were here"): Tavily and/or Firecrawl.
FIRECRAWL_API_KEY=
# Citation verification and dockets.
COURTLISTENER_API_TOKEN=
DOCKETBIRD_API_KEY=

# Research agent switches (default on; set to off to disable).
# WEB_RERANK=off           Titan-embedding rerank of web results
# WEB_RERANK_CAP_MS=1500   wall-clock cap for that rerank
# RESEARCH_PREFETCH=off    speculative last-30-days sweep at turn start
# RESEARCH_CLARIFY=off     pre-flight clarification panels
# RESEARCH_BRIEF=off       landing headlines
# BEDROCK_AGENT_TIER=      priority|flex, only with a non-Claude BEDROCK_AGENT_MODEL
