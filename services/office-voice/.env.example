# A persistent Node service; do not run inside the application's Lambda request.
PORT=8091
HOST=127.0.0.1
OFFICE_VOICE_ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# Same random secret (at least 32 bytes) in this service and platform runtime.
OFFICE_VOICE_JWT_SECRET=
AWS_REGION=us-east-1
# Use the correct platform account/role, with bedrock:InvokeModelWithBidirectionalStream.
AWS_PROFILE=
# Platform runtime additionally needs OFFICE_VOICE_PUBLIC_URL=ws://127.0.0.1:8091/voice
