[Unit]
Description=Corpus ETL stale-batch sweeper (also drains the queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=etl
WorkingDirectory=/opt/swtesting
EnvironmentFile=/etc/swtesting/etl.env
ExecStart=/usr/bin/python3 scripts/pipeline/run_batch.py --poll 60 --requeue-stale --worker-id sweeper
Restart=always
RestartSec=10
StandardOutput=append:/var/log/swtesting/etl-sweeper.log
StandardError=append:/var/log/swtesting/etl-sweeper.log

[Install]
WantedBy=multi-user.target
